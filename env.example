# Copy to .env.local and adjust values.

# Frontend app URL (local dev)
NEXT_PUBLIC_APP_URL=http://localhost:3001
PORT=3001

# Backend API — change this once to update the whole web app
NEXT_PUBLIC_API_URL=https://your-backend-url.example.com

# Google OAuth (web client)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Mapbox (optional — used by backend proxy routes)
MAPBOX_TOKEN=pk.eyJ...
